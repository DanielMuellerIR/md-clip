#!/usr/bin/env bash
# md-clip — Konvertiert Clipboard-Inhalt nach Markdown.
#
# Architektur (siehe docs/archive/BLUEPRINT.md für die Begründungen):
#   1. HTML direkt aus dem Clipboard (häufigster Fall: Browser, Claude
#      Desktop, Notion).
#   2. RTF zu HTML konvertieren, dann selber Weg wie 1.
#   3. Plain-Text durchreichen, kein Convert.
#
# Läuft auf macOS UND Linux (X11 und Wayland). Die Konvertierungs-Pipeline
# (pandoc + Perl) ist auf beiden Plattformen identisch — nur die Ränder
# unterscheiden sich, und die stecken alle im Abschnitt „Plattform-Weiche":
#
#   Aufgabe            macOS                Linux X11    Linux Wayland
#   ------------------ -------------------- ------------ -------------
#   Clipboard lesen    Swift-Helper/pbpaste xclip        wl-paste
#   Clipboard schreiben pbcopy              xclip         wl-copy
#   RTF → HTML         textutil             pandoc        pandoc
#   Notification       osascript            notify-send   notify-send
#
# Der Rest des Skripts ruft nur noch die plattformneutralen Funktionen
# clip_read_html / clip_read_rtf / clip_read_text / clip_write_text /
# rtf_to_html / notify auf und weiß nicht, auf welchem System es läuft.
#
# Default: schreibt das Ergebnis nach stdout. Mit --replace landet es
# stattdessen zurück im Clipboard (alle Rich-Flavors werden überschrieben).

# Strict-Mode für Bash:
#   -e: Bei Fehler sofort abbrechen.
#   -u: Zugriff auf undefinierte Variablen ist ein Fehler.
#   -o pipefail: Wenn ein Glied einer Pipe fehlschlägt, gilt die ganze Pipe als Fehler.
# Das macht das Skript deutlich vorhersagbarer als Default-Bash.
set -euo pipefail

# ---------- Plattform-Erkennung ----------

# Ganz früh, weil PATH, Locale und die Dependency-Checks weiter unten
# schon davon abhängen. `uname -s` ist der klassische, überall verfügbare
# Weg: "Darwin" = macOS, "Linux" = Linux.
case "$(uname -s)" in
  Darwin) PLATFORM="macos" ;;
  Linux)  PLATFORM="linux" ;;
  *)
    # Kein `die` möglich — die Funktion ist hier noch nicht definiert.
    printf 'md-clip: Nicht unterstützte Plattform: %s (unterstützt: macOS, Linux)\n' "$(uname -s)" >&2
    exit 2
    ;;
esac

# Auf Linux gibt es zwei konkurrierende Display-Server mit je eigenem
# Clipboard-Werkzeug. Die Sitzung selbst sagt uns, welcher läuft:
# WAYLAND_DISPLAY ist nur in einer Wayland-Sitzung gesetzt.
#
# Achtung, häufige Verwechslung: unter Wayland ist DISPLAY oft TROTZDEM
# gesetzt (XWayland-Kompatibilitätsschicht für alte X11-Programme). Auf
# DISPLAY zu prüfen würde Wayland-Sitzungen also fälschlich als X11
# erkennen. Darum ist WAYLAND_DISPLAY das entscheidende Signal und wird
# zuerst geprüft.
CLIP_BACKEND=""
if [ "$PLATFORM" = "linux" ]; then
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    CLIP_BACKEND="wayland"
  else
    CLIP_BACKEND="x11"
  fi
fi

# Wenn md-clip aus einer GUI-App gestartet wird (Dock-Icon, Kurzbefehle.app,
# Automator), erbt der Prozess NICHT dein Shell-PATH. Er sieht nur den
# System-PATH (/usr/bin:/bin:/...). Damit fehlen Brew-Binaries wie pandoc,
# weil die unter /usr/local/bin (Intel-Mac) bzw. /opt/homebrew/bin
# (Apple Silicon) liegen. Wir hängen beide Pfade vorne dran. Wenn sie
# nicht existieren, schadet das nicht — PATH darf nicht-existente Pfade
# enthalten.
# /opt/homebrew/bin zuerst, damit auf Apple Silicon die aktuellen
# brew-Binaries gewinnen. Bei manchen Usern liegt unter /usr/local/bin
# ein uraltes pandoc-Binary aus einem .pkg-Installer von vor Jahren,
# das brew nicht kennt und entsprechend nie aktualisiert hat. Erst die
# falsche Reihenfolge ließ md-clip dieses uralte pandoc verwenden statt
# das frisch installierte.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Gleicher GUI-Stolperstein wie beim PATH: GUI-Prozesse haben oft entweder
# kein Locale gesetzt oder das C/POSIX-Locale, das Bytes über 0x7F als
# „undefiniert" behandelt. Folge: pandoc, perl, sed interpretieren UTF-8-
# Bytes falsch, Umlaute (ä = 0xc3 0xa4) werden zerlegt und kommen als
# „Ã¤" oder „√§" o.ä. raus.
# Auf macOS setzen wir LC_ALL hart auf en_US.UTF-8 — Clipboard-Inhalte sind
# dort immer UTF-8, und sowohl pandoc/perl/sed ALS AUCH pbcopy/pbpaste
# arbeiten nur dann korrekt mit UTF-8, wenn LC_ALL auf eine NAMED
# UTF-8-Locale (lang.UTF-8) gesetzt ist. Mit LC_ALL=C/leer/bare UTF-8
# interpretieren pbcopy/pbpaste die Bytes als MacRoman.
#
# Auf Linux wäre en_US.UTF-8 die FALSCHE Wahl: Locales müssen dort erst
# erzeugt werden (`locale-gen`), und auf einem deutschen System oder in
# einem schlanken Container existiert en_US.UTF-8 schlicht nicht. Ein
# nicht existierendes LC_ALL lässt perl mit „Falling back to the standard
# locale" auf stderr meckern und kippt die Zeichenbehandlung zurück auf C
# — genau der Umlaut-Salat, den wir vermeiden wollen. C.UTF-8 dagegen ist
# in glibc fest eingebaut, braucht kein locale-gen und ist damit auf jedem
# Linux verfügbar. pbcopy/pbpaste, der einzige Grund für eine benannte
# Sprach-Locale, gibt es hier ohnehin nicht.
if [ "$PLATFORM" = "macos" ]; then
  export LC_ALL=en_US.UTF-8
  export LANG=en_US.UTF-8
else
  export LC_ALL=C.UTF-8
  export LANG=C.UTF-8
fi

# ---------- Konstanten ----------

VERSION="1.3.0"

# Pfade berechnen, damit das Skript egal von wo aus aufgerufen werden kann.
# BASH_SOURCE[0] ist der Pfad zu DIESEM Skript (auch via Symlink).
# macOS 11/12 besitzen noch kein `realpath`. Darum lösen wir Symlinks nur
# mit den seit jeher vorhandenen Bordmitteln readlink, dirname und pwd -P.
resolve_script_path() {
  local source="$1"
  local directory=""
  local target=""

  while [ -L "$source" ]; do
    directory="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)" || return 1
    target="$(readlink "$source")" || return 1
    case "$target" in
      /*) source="$target" ;;
      *)  source="$directory/$target" ;;
    esac
  done

  directory="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)" || return 1
  printf '%s/%s\n' "$directory" "$(basename "$source")"
}

SCRIPT_PATH="$(resolve_script_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Helper-Suche: zwei Layouts werden unterstützt.
#   Projekt-Layout: bin/md-clip ruft helpers/clipboard-* (Schwester-Ordner).
#   Bundle-Layout:  alle Binaries liegen NEBEN dem Skript (Contents/Resources/bin/).
# Wir probieren erst Bundle (kürzerer Pfad), dann Projekt.
#
# Nur für macOS relevant: Die Swift-Helper lesen das NSPasteboard. Auf Linux
# werden sie nie aufgerufen (dort macht xclip/wl-paste den Job) und auch nie
# geprüft — die Variablen bleiben dann einfach unbenutzt stehen.
if [ -x "$SCRIPT_DIR/clipboard-html" ]; then
  HTML_HELPER="$SCRIPT_DIR/clipboard-html"
  RTF_HELPER="$SCRIPT_DIR/clipboard-rtf"
else
  HTML_HELPER="$PROJECT_ROOT/helpers/clipboard-html"
  RTF_HELPER="$PROJECT_ROOT/helpers/clipboard-rtf"
fi

# Wenn pandoc neben uns mitgeliefert ist (Bundle-Fall), Vorrang vor System-PATH.
# Damit funktioniert die .app auch auf Macs ohne Homebrew-pandoc.
if [ -x "$SCRIPT_DIR/pandoc" ]; then
  export PATH="$SCRIPT_DIR:$PATH"
fi

# Die pandoc-Optionen leitet die Pipeline selbst aus dem Zielformat ab
# (`run_pandoc` in lib/pipeline.sh, der einzige pandoc-Aufruf der
# HTML→Markdown-Strecke); $TO wird nur noch an convert_html / convert_rtf
# übergeben.

# ---------- Flag-Defaults ----------

# Globale Flags, die wir per Argument setzen. Default-Werte hier.
INPUT_MODE=clipboard
INPUT_PATH=""
PREVIEW=0
DOCTOR=0
JSON=0
REPLACE=0       # --replace: Ergebnis ins Clipboard schreiben statt stdout
PLAIN=0         # --plain: Plain-Text-Modus, kein Convert
FROM="auto"     # --from: auto|html|rtf|plain
TO="gfm"        # --to: pandoc-Ziel-Dialekt (gfm|markdown|commonmark)
QUIET=0         # --quiet: keine Status-Logs auf stderr
NOTIFY=0        # --notify: Desktop-Notification bei Erfolg
VERBOSE=0       # --verbose: Diagnose-Output auf stderr

# ---------- Hilfsfunktionen ----------

# log: Schreibt auf stderr, außer --quiet ist gesetzt.
# Nutze das für normale Status-Meldungen.
log() {
  if [ "$QUIET" -eq 0 ]; then
    printf '%s\n' "$*" >&2
  fi
}

# vlog: Verbose-Log. Nur sichtbar mit --verbose.
# Für Diagnose-Details (welcher Flavor, welcher Pfad).
vlog() {
  if [ "$VERBOSE" -eq 1 ] && [ "$QUIET" -eq 0 ]; then
    printf '[md-clip] %s\n' "$*" >&2
  fi
}

# err: Fehler-Output auf stderr. Immer sichtbar (auch mit --quiet),
# weil Fehler nie unterdrückt werden sollen.
err() {
  printf 'md-clip: %s\n' "$*" >&2
}

# notify: Desktop-Notification anzeigen, wenn --notify gesetzt ist.
# Auf macOS via osascript (Bordmittel), auf Linux via notify-send (libnotify).
notify() {
  if [ "$NOTIFY" -eq 0 ] || [ "$QUIET" -eq 1 ]; then
    return 0
  fi

  if [ "$PLATFORM" = "macos" ]; then
    # Bundle-Layout: Die Erfolgsmeldung zeigt der HUD-Helfer als kurzes
    # Einblend-Fenster der App — ohne Erlaubnis-Mechanik des Notification
    # Centers, die für md-clips Aufrufwege (Dock, Hotkey, Skript) nicht
    # tragfähig ist (Begründung in helpers/md-clip-hud.swift). Entkoppelt
    # gestartet: Das Ein-/Ausblenden dauert gut zwei Sekunden, und darauf
    # soll weder die CLI noch der Launcher warten. Der osascript-Weg unten
    # bleibt der Fallback der git-Installation ohne App-Bundle.
    local hud
    hud="$(cd -P "$SCRIPT_DIR/../../MacOS" 2>/dev/null && pwd || true)/md-clip-hud"
    if [ -x "$hud" ]; then
      "$hud" "$1" >/dev/null 2>&1 &
      return 0
    fi
    # Anführungszeichen und Backslashes im Meldungstext würden den AppleScript-
    # Parser durcheinander bringen, wenn wir sie roh in den String interpolieren.
    # Lösung: osascript als argv-Aufruf (-e mit getrennten Argumenten) — dann
    # wird der Text als AppleScript-Literal übergeben, nicht als String-Konkatenation.
    # Das umgeht die Injection vollständig, weil kein String-Building mehr nötig ist.
    osascript \
      -e 'on run argv' \
      -e 'display notification (item 1 of argv) with title "md-clip"' \
      -e 'end run' \
      -- "$1" || true
  else
    # notify-send nimmt Titel und Text als zwei normale Argumente — kein
    # String-Building, also auch hier keine Injection möglich. Das `--`
    # trennt Optionen von Argumenten, damit eine Meldung, die mit „-"
    # beginnt, nicht als Flag missverstanden wird.
    #
    # `|| true`, weil notify-send einen laufenden Notification-Daemon über
    # D-Bus braucht: Über SSH, in einem Container oder in einer reinen
    # Terminal-Sitzung gibt es keinen — die fehlende Notification darf den
    # eigentlichen Job (Markdown konvertieren) niemals scheitern lassen.
    notify-send -- "md-clip" "$1" || true
  fi
}

# die: Fehler ausgeben, ggf. Notification, dann mit Exit-Code beenden.
# Argument 1 = Exit-Code, Rest = Fehlermeldung.
die() {
  local code="$1"; shift
  err "$*"
  notify "Fehler: $*"
  exit "$code"
}

# usage: Hilfetext ausgeben.
usage() {
  cat <<'EOF'
md-clip — Clipboard-Inhalt nach Markdown konvertieren.

USAGE
  md-clip [OPTIONS]

OPTIONS
      --stdin          Eingabe von stdin; --from html|rtf|plain erforderlich.
      --input DATEI    Datei lesen; auto erkennt .html/.htm/.rtf/.txt/.md.
      --doctor         Fähigkeiten und Abhängigkeiten prüfen, ohne Clipboard.
      --json           JSON-Ausgabe für --doctor.
      --preview        Vor --replace Ergebnis auf stderr zeigen und am Terminal
                       bestätigen; Abbruch liefert Exit 4.
  -r, --replace        Markdown-Ergebnis zurück ins Clipboard schreiben
                       (statt nach stdout).
  -p, --plain          Plain-Text-Modus: keine Konvertierung, nur Clipboard-
                       Inhalt als Plain-Text durchreichen. Mit --replace
                       ersetzt der Plain-Text das Clipboard (alle Rich-
                       Flavors gehen verloren — die echte „Paste as Plain
                       Text"-Funktion als CLI).
  -f, --from FORMAT    Eingabe-Format erzwingen: auto|html|rtf|plain
                       (default: auto).
  -t, --to FORMAT      Pandoc-Ziel-Dialekt: gfm|markdown|commonmark
                       (default: gfm).
  -q, --quiet          Keine Status-Ausgaben auf stderr.
  -n, --notify         Desktop-Notification bei Erfolg (für Wrapper-Aufrufe).
      --check-updates  Sichtbar nach App-Updates suchen (Sparkle-Dialog).
                       Nur in der macOS-App-Installation verfügbar; eine
                       git-Installation wird per git pull aktualisiert.
  -V, --verbose        Diagnose-Output (welche Flavors, welcher Pfad).
  -v, --version        Versionsnummer ausgeben.
  -h, --help           Diese Hilfe anzeigen.

EXIT-CODES
  0  Erfolg
  1  Quelle fehlt, ist leer oder nicht lesbar
  2  Ungültige Argumente, Datei oder fehlende benötigte Dependency
  3  Konvertierung nicht darstellbar oder Ausgabe fehlgeschlagen
  4  Vorschau abgebrochen

BEISPIELE
  md-clip                     # nach stdout
  md-clip --replace           # Clipboard durch Markdown ersetzen
  md-clip -p -r               # Clipboard auf reines Plain-Text reduzieren
  md-clip --verbose           # Diagnose, welcher Pfad gewählt wird
EOF
}

# ---------- Plattform-Weiche ----------
#
# Alles, was sich zwischen macOS und Linux unterscheidet, steckt in diesem
# Abschnitt. Der Rest des Skripts ruft nur die neutralen Funktionen auf.

# to_utf8: Gibt den Inhalt der Datei $1 als garantiert BOM-freies UTF-8 aus.
#
# Warum das nötig ist: Auf Linux legt Firefox seinen text/html-Flavor als
# UTF-16 aufs Clipboard (Altlast der GTK-Clipboard-Anbindung), Chromium
# dagegen als UTF-8. Wer das nicht behandelt, bekommt aus Firefox-Kopien
# Text, in dem zwischen jedem Buchstaben ein NUL-Byte steht — pandoc sieht
# darin kein HTML und liefert Müll. Weil man dem Clipboard nicht ansieht,
# welcher Browser geschrieben hat, entscheiden wir anhand der BOM
# (Byte Order Mark), der Signatur in den ersten zwei bis drei Bytes.
#
# Bewusst eine DATEI und kein stdin/Variable: Bash verwirft in `$(...)`
# NUL-Bytes — genau die Bytes, die UTF-16 ausmachen. Über eine Variable
# wäre der Text also schon kaputt, bevor wir ihn ansehen könnten.
to_utf8() {
  local file="$1"
  local bom

  # Erste 3 Bytes als Hex lesen. `od -An -tx1` gibt sie durch Leerzeichen
  # getrennt aus, `tr -d` macht daraus eine durchgehende Hex-Kette.
  bom="$(head -c 3 "$file" | od -An -tx1 | tr -d ' \n')"

  case "$bom" in
    fffe*|feff*)
      # UTF-16, Little- oder Big-Endian. Wir übergeben iconv bewusst
      # „UTF-16" OHNE LE/BE-Suffix: In dieser Form wertet iconv die BOM
      # selbst aus, erkennt die Byte-Reihenfolge daran und entfernt sie
      # aus der Ausgabe. Mit „UTF-16LE" müssten wir die Reihenfolge selbst
      # bestimmen und die BOM bliebe als unsichtbares Zeichen im Text stehen.
      iconv -f UTF-16 -t UTF-8 < "$file"
      ;;
    efbbbf*)
      # UTF-8 mit BOM. Der Inhalt stimmt schon, nur die drei BOM-Bytes
      # müssen weg — sonst landen sie als unsichtbarer Fleck am Anfang des
      # Markdowns. `tail -c +4` gibt alles ab dem 4. Byte aus.
      tail -c +4 "$file"
      ;;
    *)
      # Kein BOM → schon reines UTF-8, unverändert durchreichen.
      cat "$file"
      ;;
  esac
}

# linux_clip_read: Liest den ersten verfügbaren der übergebenen MIME-Typen
# vom Clipboard und gibt ihn als UTF-8 auf stdout aus.
# Exit 0 = etwas gefunden, Exit 1 = keiner der Typen liegt an.
#
# Mehrere Typen, weil sich die Programme nicht einig sind: RTF liegt je nach
# Quelle als text/rtf oder als application/rtf an.
linux_clip_read() {
  local mime tmp
  tmp="$(mktemp)"

  for mime in "$@"; do
    # `|| continue`: Fehlt der Typ auf dem Clipboard, melden xclip und
    # wl-paste einen Fehler — das ist hier kein Problem, sondern die
    # normale Antwort „hab ich nicht", also nächsten Typ probieren.
    if [ "$CLIP_BACKEND" = "wayland" ]; then
      wl-paste --no-newline --type "$mime" > "$tmp" 2>/dev/null || continue
    else
      xclip -selection clipboard -target "$mime" -out > "$tmp" 2>/dev/null || continue
    fi

    # `-s` = Datei existiert UND ist nicht leer. Der Test ist nötig, weil
    # manche xclip-Versionen bei fehlendem Typ trotzdem Exit 0 melden und
    # einfach nichts ausgeben.
    if [ -s "$tmp" ]; then
      # Das `|| { … }` ist die Aufräum-Garantie: Ohne den Zweig würde ein
      # Fehler in to_utf8 (z.B. kaputtes UTF-16) die Temp-Datei liegen lassen.
      to_utf8 "$tmp" || { rm -f "$tmp"; return 1; }
      rm -f "$tmp"
      return 0
    fi
  done

  rm -f "$tmp"
  return 1
}

# clip_read_html: HTML-Flavor vom Clipboard holen.
# Exit 0 + HTML auf stdout, wenn vorhanden; sonst Exit 1 ohne Ausgabe.
clip_read_html() {
  if [ "$PLATFORM" = "macos" ]; then
    "$HTML_HELPER" 2>/dev/null
  else
    linux_clip_read text/html
  fi
}

# clip_read_rtf: RTF-Flavor vom Clipboard holen.
#
# Auf macOS nutzen wir den Swift-Helper statt `pbpaste -Prefer rtf`, weil
# pbpaste auf Plain Text ausweicht, sobald zusätzlich zum RTF auch RTFD auf
# dem Clipboard liegt (typisch für TextEdit-Inhalte mit Bildern). Der Helper
# greift direkt auf den .rtf-Flavor in NSPasteboard zu — zuverlässig.
clip_read_rtf() {
  if [ "$PLATFORM" = "macos" ]; then
    "$RTF_HELPER" 2>/dev/null
  else
    linux_clip_read text/rtf application/rtf
  fi
}

# clip_read_text: Plain-Text vom Clipboard holen.
clip_read_text() {
  if [ "$PLATFORM" = "macos" ]; then
    pbpaste
  elif [ "$CLIP_BACKEND" = "wayland" ]; then
    # --no-newline: wl-paste hängt sonst ein Newline an, das im Original
    # nicht stand. pbpaste tut das nicht — so verhalten sich beide gleich.
    wl-paste --no-newline 2>/dev/null
  else
    xclip -selection clipboard -out 2>/dev/null
  fi
}

# clip_write_text: Plain-Text von stdin ins Clipboard schreiben.
# Ersetzt den Inhalt komplett — alle Rich-Flavors (HTML, RTF) verschwinden.
clip_write_text() {
  if [ "$PLATFORM" = "macos" ]; then
    pbcopy
  elif [ "$CLIP_BACKEND" = "wayland" ]; then
    wl-copy
  else
    # xclip forkt sich in den Hintergrund und hält die Auswahl, solange kein
    # anderes Programm sie übernimmt — so verlangt es das X11-Clipboard-
    # Protokoll: Es gibt keinen zentralen Speicher, der Besitzer liefert den
    # Inhalt auf Anfrage aus. Stirbt der Prozess, ist das Clipboard leer.
    #
    # Ohne umgeleitete Standard-Kanäle würde dieser Hintergrund-Prozess die
    # Pipe unserer Aufrufer offen halten: `md-clip --replace | cat` bliebe
    # dann hängen, bis xclip irgendwann endet. Darum stdout/stderr nach
    # /dev/null — md-clip kehrt sofort zurück, xclip lebt weiter.
    xclip -selection clipboard -in >/dev/null 2>&1
  fi
}

# rtf_fix_escaped_newlines liegt in lib/pipeline.sh und wird dort von
# Produkt und Tests gemeinsam verwendet.

# rtf_to_html: RTF von stdin nach HTML auf stdout.
#
# macOS: textutil (Bordmittel, nutzt Apples eigenen RTF-Parser).
# Linux: pandocs RTF-Reader (seit pandoc 2.19), plus die Spec-Korrektur oben.
#
# Beide Wege liefern für tests/fixtures/word-rtf.rtf identisches Markdown —
# das pinnt der word-rtf-Test auf beiden Plattformen gegen dieselbe Erwartung.
rtf_to_html() {
  if [ "$PLATFORM" = "macos" ]; then
    # textutil setzt die \par-Kurzform von sich aus korrekt um — hier ist
    # rtf_fix_escaped_newlines nicht nötig und bleibt bewusst weg, damit der
    # macOS-Pfad exakt der bisherige bleibt.
    textutil -convert html -format rtf -stdin -stdout
  else
    rtf_fix_escaped_newlines | pandoc -f rtf -t html
  fi
}

# ---------- Flag-Parsing ----------

# Argumente durchgehen, lange und kurze Form akzeptieren.
# `getopts` (Bash-Builtin) kann nur kurze Optionen — daher manuell.
while [ "$#" -gt 0 ]; do
  case "$1" in
    --stdin)
      [ "$INPUT_MODE" = clipboard ] || die 2 "Nur eine Eingabequelle erlaubt."
      INPUT_MODE=stdin ;;
    --input)
      [ "$INPUT_MODE" = clipboard ] || die 2 "Nur eine Eingabequelle erlaubt."
      shift
      [ -n "${1:-}" ] || die 2 "--input benötigt einen Dateipfad."
      INPUT_MODE=file; INPUT_PATH="$1" ;;
    --doctor) DOCTOR=1 ;;
    --json) JSON=1 ;;
    --preview) PREVIEW=1 ;;
    -r|--replace)   REPLACE=1 ;;
    -p|--plain)     PLAIN=1 ;;
    -f|--from)
      # Wert prüfen: muss eines der erlaubten Formate sein.
      shift
      case "${1:-}" in
        auto|html|rtf|plain) FROM="$1" ;;
        *) die 2 "Ungültiges --from: '${1:-}' (erlaubt: auto, html, rtf, plain)" ;;
      esac
      ;;
    -t|--to)
      shift
      case "${1:-}" in
        gfm|markdown|commonmark) TO="$1" ;;
        *) die 2 "Ungültiges --to: '${1:-}' (erlaubt: gfm, markdown, commonmark)" ;;
      esac
      ;;
    -q|--quiet)     QUIET=1 ;;
    -n|--notify)    NOTIFY=1 ;;
    -V|--verbose)   VERBOSE=1 ;;
    -v|--version)
      # md-clip-Version + pandoc-Version (vorzugsweise das gebundelte
      # Binary, sonst das aus dem PATH). Nützlich beim Bug-Reporting,
      # weil sich das pandoc-Verhalten zwischen Versionen merklich
      # unterscheiden kann.
      printf 'md-clip %s\n' "$VERSION"
      # Plattform + Clipboard-Backend mit ausgeben: Beim Bug-Reporting ist
      # „X11 statt Wayland erkannt" eine der ersten Fragen.
      if [ "$PLATFORM" = "macos" ]; then
        printf 'System  macOS\n'
      else
        printf 'System  Linux (%s)\n' "$CLIP_BACKEND"
      fi
      if [ -x "$SCRIPT_DIR/pandoc" ]; then
        printf 'pandoc  %s (gebundelt)\n' "$("$SCRIPT_DIR/pandoc" --version 2>/dev/null | head -1 | awk '{print $2}')"
      elif command -v pandoc >/dev/null 2>&1; then
        printf 'pandoc  %s (System)\n'    "$(pandoc --version 2>/dev/null | head -1 | awk '{print $2}')"
      else
        printf 'pandoc  nicht installiert\n'
      fi
      exit 0
      ;;
    -h|--help)      usage; exit 0 ;;
    --check-updates)
      # Sichtbare Update-Suche über Sparkle. Aktualisiert wird die App-
      # Installation: Der Updater-Helfer liegt im App-Bundle unter
      # Contents/MacOS/, dieses Skript im selben Bundle unter
      # Contents/Resources/bin/ — daher der Verwandtschaftspfad. Eine
      # git-/install.sh-Installation hat keinen Updater (Update-Weg dort:
      # git pull), und unter Linux gibt es keine App.
      # `|| true`, damit ein fehlendes MacOS-Verzeichnis (kein Bundle-Layout)
      # unter `set -e` nicht das Skript beendet, sondern unten sauber in der
      # Fehlermeldung landet.
      UPDATER_DIR="$(cd -P "$SCRIPT_DIR/../../MacOS" 2>/dev/null && pwd || true)"
      if [ "$PLATFORM" != "macos" ] || [ -z "$UPDATER_DIR" ] || [ ! -x "$UPDATER_DIR/md-clip-updater" ]; then
        die 2 "Die Update-Suche gibt es nur in der macOS-App-Installation (md-clip.app). Diese Installation wird per git pull bzw. install.sh aktualisiert."
      fi
      exec "$UPDATER_DIR/md-clip-updater" --interactive
      ;;
    --)
      shift
      if [ "$#" -gt 0 ]; then
        die 2 "Unerwartetes Argument: $1 (siehe --help)"
      fi
      break
      ;;
    -*) die 2 "Unbekannte Option: $1 (siehe --help)" ;;
    *)  die 2 "Unerwartetes Argument: $1 (siehe --help)" ;;
  esac
  shift
done


# ---------- Dependency-Checks ----------

# command -v $cmd liefert leeren Output und Exit 1, wenn $cmd nicht im PATH ist.
# Wir prüfen hier alle Pflicht-Binaries — early-fail mit klarem Fehlertext.
# Nur Werkzeuge des tatsächlich ausgeführten Weges prüfen. Rückgabe statt
# exit: auto darf einen nicht verfügbaren Rich-Weg überspringen.
check_dependencies() {
  local kind="$1" tool
  local required=()
  case "$kind" in
    html|rtf) required=(pandoc perl) ;;
  esac
  if [ "$kind" = rtf ] && [ "$PLATFORM" = macos ]; then required+=(textutil); fi
  if [ "$kind" = read ] || [ "$kind" = write ]; then
    case "$PLATFORM:$CLIP_BACKEND:$kind" in
      macos:*:read)
        case "$FROM" in
          html) [ -x "$HTML_HELPER" ] || { err "HTML-Helper fehlt (install.sh ausführen)."; return 2; } ;;
          rtf) [ -x "$RTF_HELPER" ] || { err "RTF-Helper fehlt (install.sh ausführen)."; return 2; } ;;
          plain) required=(pbpaste) ;;
          auto) ;; # Fehlende einzelne Flavor-Werkzeuge überspringen.
        esac ;;
      macos:*:write) required=(pbcopy) ;;
      linux:wayland:read) required=(wl-paste) ;;
      linux:wayland:write) required=(wl-copy) ;;
      linux:x11:*) required=(xclip) ;;
    esac
  fi
  for tool in ${required[@]+"${required[@]}"}; do
    command -v "$tool" >/dev/null 2>&1 || {
      err "Fehlende Dependency: $tool"; return 2;
    }
  done
  case "$kind" in
    html|rtf)
      if ! pandoc_supports_sandbox; then
        err "Das installierte pandoc kennt die Option --sandbox nicht. Bitte pandoc >= 2.15 installieren."
        return 2
      fi ;;
  esac
  if [ "$kind" = rtf ] && [ "$PLATFORM" = linux ] && ! pandoc_supports_rtf; then
    err "Pandoc unterstützt das Eingabeformat RTF nicht. Bitte pandoc >= 2.15 installieren."
    return 2
  fi
}

# Doctor liefert ausschließlich Werkzeugdaten, niemals Zwischenablage-Inhalte.
doctor() {
  local tool available version path sep="" sandbox=false rtf=false lua=false
  pandoc_supports_sandbox && sandbox=true
  pandoc_supports_rtf && rtf=true
  pandoc_supports_table_filter && lua=true
  if [ "$JSON" -eq 1 ]; then
    printf '{"version":"%s","backend":"%s","sandbox":%s,"rtf_reader":%s,"table_filter":%s,"stdin":true,"files":true,"preview":true,"undo":false,"dependencies":{' "$VERSION" "${CLIP_BACKEND:-macos}" "$sandbox" "$rtf" "$lua"
  else
    printf 'md-clip %s; Backend: %s\n' "$VERSION" "${CLIP_BACKEND:-macos}"
    printf 'stdin/Datei: ja; Vorschau: Terminal; Undo: nein\nSandbox: %s; RTF-Reader: %s; Tabellenfilter: %s\n' "$sandbox" "$rtf" "$lua"
  fi
  for tool in pandoc perl textutil pbpaste pbcopy xclip wl-paste wl-copy iconv clipboard-html clipboard-rtf; do
    available=false; version=""
    case "$tool" in
      clipboard-html) path="$HTML_HELPER" ;;
      clipboard-rtf) path="$RTF_HELPER" ;;
      *) path=$(command -v "$tool" || true) ;;
    esac
    if [ -n "$path" ] && [ -x "$path" ]; then
      available=true
      case "$tool" in
        pandoc) version=$(pandoc --version 2>/dev/null | head -1 || true) ;;
        perl) version=$(perl -e 'printf "%vd", $^V' 2>/dev/null || true) ;;
        wl-copy|wl-paste) version=$("$tool" --version 2>/dev/null | head -1 || true) ;;
        xclip) version=$(xclip -version 2>&1 | head -1 || true) ;;
        *) version="Systemwerkzeug (Version separat nicht verfuegbar)" ;;
      esac
    fi
    version=$(printf '%s' "$version" | LC_ALL=C tr -cd '[:print:]')
    # Shell-Escaping für die einzigen dynamischen JSON-Strings.
    version=${version//\\/\\\\}; version=${version//\"/\\\"}
    version=${version//$'\n'/ }; version=${version//$'\r'/ }; version=${version//$'\t'/ }
    if [ "$JSON" -eq 1 ]; then
      printf '%s"%s":{"available":%s,"version":"%s"}' "$sep" "$tool" "$available" "$version"
      sep=,
    else
      printf '%s: %s %s\n' "$tool" "$available" "$version"
    fi
  done
  [ "$JSON" -eq 0 ] || printf '}}\n'
}

# ---------- Gemeinsame Konvertierungs-Pipeline ----------

# Bundle-Layout: pipeline.sh liegt neben md-clip. Projekt-Layout: lib/pipeline.sh.
if [ -f "$SCRIPT_DIR/pipeline.sh" ]; then
  PIPELINE_LIB="$SCRIPT_DIR/pipeline.sh"
else
  PIPELINE_LIB="$PROJECT_ROOT/lib/pipeline.sh"
fi
if [ ! -f "$PIPELINE_LIB" ]; then
  die 2 "Pipeline-Bibliothek fehlt: $PIPELINE_LIB"
fi
# shellcheck source=../lib/pipeline.sh
source "$PIPELINE_LIB"

# try_html: Versucht HTML aus dem Clipboard zu holen.
# Liefert HTML auf stdout und Exit 0, wenn vorhanden; sonst Exit 1.
try_html() {
  clip_read_html
}

# is_mso_html: Prüft, ob ein HTML-Blob aus Microsoft Word stammt.
# Word legt seine eigene HTML-Variante aufs Clipboard, voller Office-XML-
# Namespaces und mso-*-CSS — strukturell so verbogen, dass Pandoc damit
# komplett überfordert ist (Output: rohes HTML statt Markdown). Wenn wir
# diese Variante erkennen, ist der RTF-Pfad fast immer das bessere
# Ergebnis. Heuristik:
#   1. Office-Namespace im <html>-Tag (sehr zuverlässig), ODER
#   2. mindestens 10 `mso-`-Marker im Body (Fallback für variantenreiche
#      Office-Versionen).
# Argument: $1 = HTML-Inhalt.
# Rückgabe: 0 wenn MSO, 1 wenn normales HTML.
is_mso_html() {
  local html="$1"

  # Schneller, exakter Check: Office-XML-Namespace im <html>-Tag.
  # Das dritte Pattern (*'Microsoft Word'*'Generator'*) wurde entfernt: Im echten
  # Word-HTML steht "Generator" im Meta-Tag VOR "Microsoft Word" — die umgekehrte
  # Reihenfolge trifft niemals zu. Das zweite Pattern (*'name=Generator content="Microsoft'*)
  # deckt diesen Fall korrekt ab.
  case "$html" in
    *'microsoft-com:office'*)  return 0 ;;
    *'name=Generator content="Microsoft'*)  return 0 ;;
  esac

  # Fallback: tatsächliche mso-Marker zählen, nicht nur Zeilen mit Treffern.
  # Word-HTML kann minifiziert in einer einzigen Zeile ankommen; `grep -c`
  # lieferte dafür unabhängig von der Markerzahl nur 1 und verfehlte die
  # Erkennung. Die Längendifferenz ist exakt vier Zeichen je entferntem
  # ASCII-Marker und braucht keinen weiteren Prozess.
  local without_mso count
  without_mso="${html//mso-/}"
  count=$(( (${#html} - ${#without_mso}) / 4 ))
  [ "${count:-0}" -ge 10 ] && return 0

  return 1
}

# try_rtf: Versucht RTF aus dem Clipboard zu holen.
# Liefert RTF auf stdout und Exit 0, wenn vorhanden; sonst Exit 1.
try_rtf() {
  clip_read_rtf
}

# ---------- Quellenwahl und Eingabevertrag ----------

[ "$JSON" -eq 0 ] || [ "$DOCTOR" -eq 1 ] || die 2 "--json benötigt --doctor."
if [ "$DOCTOR" -eq 1 ]; then
  [ "$INPUT_MODE" = clipboard ] && [ "$REPLACE" -eq 0 ] && [ "$PREVIEW" -eq 0 ] || die 2 "--doctor ist nicht mit Eingabe oder Ersetzen kombinierbar."
  doctor
  exit 0
fi
[ "$PREVIEW" -eq 0 ] || [ "$REPLACE" -eq 1 ] || die 2 "--preview benötigt --replace."
if [ "$PLAIN" -eq 1 ]; then
  case "$FROM" in auto|plain) FROM=plain ;; *) die 2 "--plain widerspricht --from $FROM." ;; esac
fi
if [ "$INPUT_MODE" != clipboard ] && [ "$FROM" = auto ]; then
  case "$INPUT_MODE:$INPUT_PATH" in
    file:*.html|file:*.htm) FROM=html ;;
    file:*.rtf) FROM=rtf ;;
    file:*.txt|file:*.md) FROM=plain ;;
    *) die 2 "Für diese Eingabe --from html|rtf|plain angeben." ;;
  esac
fi
if [ "$INPUT_MODE" = file ]; then
  [ -f "$INPUT_PATH" ] && [ -r "$INPUT_PATH" ] || die 2 "Eingabedatei ist keine lesbare reguläre Datei: $INPUT_PATH"
fi
if [ "$INPUT_MODE" = clipboard ]; then check_dependencies read || exit 2; fi
if [ "$REPLACE" -eq 1 ]; then check_dependencies write || exit 2; fi

WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/md-clip.XXXXXX")
OUTPUT_FILE="$WORK_DIR/output"
export MD_CLIP_RESULT_FILE="$WORK_DIR/result"
cleanup_output() { rm -rf "$WORK_DIR"; }
trap cleanup_output EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Dateien erhalten auch NUL-Bytes und abschließende Newlines. Kein Nutzdaten-
# Transport über Shell-Variablen; nur die Word-Heuristik liest einen HTML-String.
read_source() {
  local kind="$1" dest="$2"
  if [ "$INPUT_MODE" = stdin ]; then cat > "$dest"
  elif [ "$INPUT_MODE" = file ]; then cat < "$INPUT_PATH" > "$dest"
  else
    case "$kind" in
      html) clip_read_html > "$dest" ;;
      rtf) clip_read_rtf > "$dest" ;;
      plain) clip_read_text > "$dest" ;;
    esac
  fi
}

# Quellen einmal lesen, dann in fester Reihenfolge versuchen. Ein fehlender
# Flavor ist keine erfolgreiche leere Eingabe und darf nicht ersetzen.
ORDER="$FROM"
if [ "$FROM" = auto ]; then
  read_source html "$WORK_DIR/html" 2>/dev/null || rm -f "$WORK_DIR/html"
  read_source rtf "$WORK_DIR/rtf" 2>/dev/null || rm -f "$WORK_DIR/rtf"
  read_source plain "$WORK_DIR/plain" 2>/dev/null || rm -f "$WORK_DIR/plain"
  ORDER="html rtf plain"
  if [ -s "$WORK_DIR/html" ] && is_mso_html "$(cat "$WORK_DIR/html")"; then
    ORDER="rtf html plain"
    vlog "Microsoft Word: Reihenfolge RTF → HTML → Klartext"
  fi
else
  read_source "$FROM" "$WORK_DIR/$FROM" || die 1 "Quelle $FROM konnte nicht gelesen werden."
fi

# ---------- Konvertierung und Ergebnisbewertung ----------
CONVERTED=0
RESULT=""
convert_source() {
  local kind="$1" status
  : > "$MD_CLIP_RESULT_FILE"
  if [ "$kind" = plain ]; then
    cat "$WORK_DIR/plain" > "$OUTPUT_FILE" || return 3
    RESULT="Klartext übernommen"
    return 0
  fi
  check_dependencies "$kind" || return 2
  if "convert_$kind" "$TO" < "$WORK_DIR/$kind" > "$OUTPUT_FILE"; then
    [ -s "$OUTPUT_FILE" ] || return 3
  else
    return 3
  fi
  CONVERTED=1
  RESULT="Markdown erzeugt"
  if [ -s "$MD_CLIP_RESULT_FILE" ]; then RESULT="Struktur vereinfacht; Markdown erzeugt"; fi
}

HAD_SOURCE=0
for source_kind in $ORDER; do
  if [ ! -s "$WORK_DIR/$source_kind" ]; then
    [ "$FROM" = auto ] && continue
    die 1 "Quelle $source_kind ist leer."
  fi
  HAD_SOURCE=1
  if convert_source "$source_kind" 2> "$WORK_DIR/diagnostic"; then
    if [ "$VERBOSE" -eq 1 ] && [ "$QUIET" -eq 0 ]; then cat "$WORK_DIR/diagnostic" >&2; fi
    vlog "Quelle: $source_kind"
    break
  else
    status=$?
    if [ "$FROM" != auto ]; then
      cat "$WORK_DIR/diagnostic" >&2
      die "$status" "Konvertierung von $source_kind fehlgeschlagen."
    fi
    vlog "Quelle $source_kind nicht konvertierbar (Exit $status); nächste Quelle"
    if [ "$VERBOSE" -eq 1 ] && [ "$QUIET" -eq 0 ]; then cat "$WORK_DIR/diagnostic" >&2; fi
  fi
done
[ "$HAD_SOURCE" -eq 1 ] || die 1 "Keine Quelle liefert Inhalt; Clipboard bleibt unverändert."
[ -n "$RESULT" ] || die 3 "Keine Quelle liefert Inhalt; Clipboard bleibt unverändert."

# Output ausliefern: entweder Clipboard ersetzen oder stdout.
if [ "$REPLACE" -eq 1 ]; then
  # Schluss-Newline eines KONVERTIERTEN Ergebnisses vor dem Clipboard weg.
  # pandoc beendet sein Markdown immer mit einem LF. In einer Datei ist das
  # richtig, im Clipboard nicht: Beim Einfügen entsteht daraus eine zusätzliche
  # leere Zeile, die im kopierten Original nie stand. Durchgereichter
  # Plain-Text bleibt davon unberührt — dort sind die Newlines Nutzdaten und
  # müssen bytegenau erhalten bleiben (siehe tests/test-plain-newlines.sh).
  #
  # GENAU EINS, nicht `\n+`: Endet das Dokument auf einen echten leeren Absatz,
  # liefert die Kette zwei LFs — eines ist Pandocs Dateiende, das andere der
  # Absatz. `\n+` fraß beide und damit den Absatz (Review-Fund 2026-08-05,
  # belegt an `<p>a</p><p><br></p>` → `a\n\n`).
  if [ "$CONVERTED" -eq 1 ]; then
    perl -0777 -i -pe 's/\n\z//' "$OUTPUT_FILE"
  fi

  # Letzte Schutzlinie direkt vor der destruktiven Clipboard-Operation. Die
  # Konverter lehnen leere Ausgabe bereits ab; dieser Check verhindert auch
  # bei künftigen Pfaden ein erfolgreich gemeldetes 0-Byte-Clipboard.
  if [ ! -s "$OUTPUT_FILE" ]; then
    die 1 "Ergebnis ist leer; Clipboard bleibt unverändert."
  fi

  # clip_write_text liest von stdin und ersetzt den Clipboard-Inhalt
  # komplett — alle Rich-Flavors (HTML, RTF) verschwinden, nur Plain bleibt.
  # Der globale Export LC_ALL weiter oben ist hier wichtig: pbcopy (macOS)
  # interpretiert Input-Bytes als MacRoman, wenn LC_ALL leer oder C ist,
  # und legt dann FALSCHE Zeichen aufs Clipboard, was beim Einfügen in
  # andere Apps Mojibake produziert.
  if [ "$PREVIEW" -eq 1 ]; then
    # Eingabe bleibt auf stdin nutzbar; die Entscheidung kommt separat vom TTY.
    [ -t 2 ] && ( : < /dev/tty ) 2>/dev/null || die 2 "Vorschau benötigt ein interaktives Terminal."
    printf '%s\n' '--- Vorschau ---' >&2
    cat "$OUTPUT_FILE" >&2
    printf '\nClipboard ersetzen? [ja/Nein] ' >&2
    answer=""
    IFS= read -r answer < /dev/tty || exit 4
    [ "$answer" = ja ] || exit 4
  fi
  clip_write_text < "$OUTPUT_FILE" || die 3 "Clipboard konnte nicht geschrieben werden."
  OUTPUT_CHARS=$(wc -m < "$OUTPUT_FILE" | tr -d '[:space:]')
  log "md-clip: $RESULT; Clipboard ersetzt (${OUTPUT_CHARS} Zeichen)."
  notify "$RESULT; im Clipboard."
else
  cat "$OUTPUT_FILE"
  log "md-clip: $RESULT."
  notify "$RESULT; auf stdout."
fi

exit 0
