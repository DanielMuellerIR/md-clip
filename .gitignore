# Kompilierte Swift-Helper-Binaries — werden via install.sh erzeugt.
helpers/clipboard-html
helpers/clipboard-rtf

# Spike-Binary (gleicher Source wie helpers/clipboard-html.swift).
spike/clipboard-html

# Kompilierter Test-Helper — wird von tests/compare-file.sh erzeugt.
tests/load-clipboard

# Manuell gesammelte Clipboard-Aufnahmen — Test-Daten, keine Source.
tests/captures/

# Gebaute Dock-App — wird via wrappers/build-app.sh erzeugt.
wrappers/md-clip.app

# Build-Ordner für das self-contained .app-Bundle (inkl. pandoc-Cache).
build/

# macOS-Metadaten.
.DS_Store
