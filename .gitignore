# Kompilierte Swift-Helper-Binaries — werden via install.sh erzeugt.
helpers/clipboard-html
helpers/clipboard-rtf

# Manuell gesammelte Clipboard-Aufnahmen — Test-Daten, keine Source.
tests/captures/

# Build-Ordner für das self-contained .app-Bundle (inkl. pandoc-Cache).
build/

# Lokale Sperre des Safe-Commit-Workflows.
.commit-lock

# Python-Bytecode — entsteht beim Lauf von assets/generate-icon-v2.py.
__pycache__/

# macOS-Metadaten.
.DS_Store

# Frueherer Ablageort der kompilierten Test-Helfer. Heute bauen die
# Test-Skripte sie nach $TEST_RUNTIME; auf aelteren Arbeitskopien liegen
# sie noch neben ihrer .swift-Quelle.
tests/clipboard-string
tests/load-clipboard

# Frueherer Ausgabeort des App-Bundles — build-app-bundled.sh schreibt
# heute nach build/md-clip.app.
wrappers/md-clip.app/

# Ordner fuer Handversuche, kein Quellcode.
spike/
